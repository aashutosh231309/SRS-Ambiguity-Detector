# Copy to `.env.local` and edit. `NEXT_PUBLIC_*` is embedded in the browser bundle —
# NEVER put secrets here (docs/SECURITY_SPEC.md §2).
#
# Legend: [required:dev] needed for local dev · [optional] has a safe default.

# [required:dev] Browser → API base URL (the ONLY backend address the browser uses).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# [optional] Canonical site URL (SEO metadata, sitemap, robots). Defaults to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stage 22 : CAPTCHA (public site key by design) ---
# Leave unset locally to hide the widget; set with backend TURNSTILE_ENABLED=true in prod.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=changeme-turnstile-site-key

# [optional:Stage 24] Frontend error monitoring. DSN is public by Sentry design;
# leave blank locally/tests. Scrubber disables PII and removes forms/bodies/tokens.
NEXT_PUBLIC_SENTRY_DSN=
# [optional] Release/environment metadata; never put credentials here.
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
