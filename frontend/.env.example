# Copy to `.env.local` and edit. `NEXT_PUBLIC_*` is embedded in the browser bundle —
# NEVER put secrets here (docs/SECURITY_SPEC.md §2).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

