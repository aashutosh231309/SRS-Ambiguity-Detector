# ============================================================================
# SRS Ambiguity Detector — MASTER environment inventory (placeholders ONLY).
# ============================================================================
# This file is DOCUMENTATION. Neither service reads it at runtime:
#   - Backend (FastAPI) reads  backend/.env          (see backend/.env.example)
#   - Frontend (Next.js) reads frontend/.env.local   (see frontend/.env.example)
#   - docker compose reads  .env at the REPO ROOT for ${POSTGRES_*} only.
#
# To start locally: copy backend/.env.example → backend/.env and
# frontend/.env.example → frontend/.env.local, then edit values.
#
# NEVER commit real secrets. NEVER put real keys in ANY .example file.
# Full matrix: docs/ARCHITECTURE.md §7. Vault design: docs/SECURITY_SPEC.md §4.
# ============================================================================

# --- Local Postgres (docker compose only; defaults work out of the box) ---
POSTGRES_USER=srs
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=srs_ambiguity
POSTGRES_PORT=5432

# --- Backend (→ backend/.env) ---
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://srs:changeme-local-only@localhost:5432/srs_ambiguity
DIRECT_DATABASE_URL=postgresql+asyncpg://srs:changeme-local-only@localhost:5432/srs_ambiguity
BACKEND_CORS_ORIGINS=http://localhost:3000
JWT_SECRET=changeme-256-bit-secret-min-32-bytes
ENCRYPTION_MASTER_KEY=changeme-fernet-key-see-backend-.env.example-for-generator
RESEND_API_KEY=changeme-resend-key
TURNSTILE_SECRET_KEY=changeme-turnstile-secret
SENTRY_DSN=

# --- Frontend (→ frontend/.env.local; NEXT_PUBLIC_* is public by design) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Deliberately ABSENT: global AI provider keys ---
# There are NO GEMINI_API_KEY / GROQ_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY /
# OPENROUTER_API_KEY / HUGGINGFACE_API_KEY variables in this project. Users bring
# their OWN keys, stored encrypted PER USER (see docs/AI_PROVIDER_SPEC.md §5 and
# docs/SECURITY_SPEC.md §4). No global/shared inference key exists by design.
