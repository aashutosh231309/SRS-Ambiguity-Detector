# Copy to `.env` and edit. NEVER commit `.env` or real secrets.
# All values here are placeholders — replace every `changeme-*`.

APP_NAME=SRS Ambiguity Detector
APP_ENV=local
# local | staging | production — switches docs, cookie Secure, frame headers, HSTS.
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Comma-separated exact origins (no trailing slash). No `*` with credentials, ever.
# Development: the local Next.js origin(s) below. Production: the deployed frontend
# origin(s) ONLY (e.g. https://app.example.com) — set per environment, never shared.
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Stage 02+ : database (unused by the Stage-00 skeleton) ---
# DATABASE_URL: pooled connection for the app (Supabase pooler in staging/prod).
# DIRECT_DATABASE_URL: direct connection for Alembic migrations (no pooler).
# DATABASE_URL=postgresql+asyncpg://srs:changeme-local-only@localhost:5432/srs_ambiguity
# DIRECT_DATABASE_URL=postgresql+asyncpg://srs:changeme-local-only@localhost:5432/srs_ambiguity

# --- Stage 04 : auth (IMPLEMENTED — JWT_SECRET is required for any auth endpoint) ---
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=changeme-256-bit-secret-min-32-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=60
# console = local dev only (metadata logs + full mail incl. links to DEV_OUTBOX_DIR;
# REFUSED in production). resend = production delivery (requires the key below).
EMAIL_PROVIDER=console
RESEND_API_KEY=changeme-resend-key
EMAIL_FROM=SRS Ambiguity Detector <noreply@example.com>
# Public base URL baked into emailed verify/reset links (no trailing slash).
APP_BASE_URL=http://localhost:3000
DEV_OUTBOX_DIR=./.dev-outbox
# Auth rate limits: single-process token buckets (exact behind one worker; Stage 22
# distributes). Per-endpoint+IP per minute; exhausted buckets answer 429 + Retry-After.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=60
# Stage 06: per-user analyses per minute (verified guard; 401s never consume budget).
RATE_LIMIT_ANALYSIS_PER_MINUTE=20
# Stage 06 budgets (contract-fixed constants, NOT env): text ≤ 200 000 chars
# (schemas/analysis.py TEXT_MAX_LENGTH) and requirements cap enforced post-
# segmentation (services/segmentation.py MAX_REQUIREMENTS).
# Stage 08: per-user document uploads per minute (tighter than text posts —
# uploads are resource-intensive; 401s never consume budget).
RATE_LIMIT_UPLOADS_PER_MINUTE=10
# Stage 12: per-user AI credential tests per minute (tests can trigger
# external provider calls; 401s never consume budget).
RATE_LIMIT_AI_TEST_PER_MINUTE=10
# Stage 08 upload/extract budgets (request-time resolution — retunable per env).
# Per-file byte cap, enforced on the TRUE streamed count (never declared size).
MAX_UPLOAD_SIZE_BYTES=10485760
# Extracted-text char cap (== TEXT pipeline budget: same downstream path).
MAX_EXTRACTED_TEXT_CHARS=200000
# Files per upload request (sync pipeline analyzes one file per call).
MAX_FILES_PER_REQUEST=1
# Wall-clock budget for validate+extract (past this: 503, temp still cleaned).
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=60
# Storage backend: `local` dev adapter (server-generated keys under the dir).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
# argon2id work factors (single hash ≈ 200–500 ms here; tests use these exact values).
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- Prod stages : Supabase storage (reserved; local adapter live since Stage 08) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=changeme-supabase-service-role-key
# SUPABASE_STORAGE_BUCKET=srs-documents

# --- Stage 12 : AI credential vault (IMPLEMENTED — SECURITY_SPEC §4) ---
# ENCRYPTION_MASTER_KEY: Fernet master key (32 bytes, base64) encrypting per-user
# provider keys at rest. REQUIRED for any vault write/read (fail closed); the app
# boots and analyzes without it (AI is optional). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# There are deliberately NO global GEMINI/GROQ/OPENAI/... keys — user-owned only.
ENCRYPTION_MASTER_KEY=changeme-fernet-key-see-generator-above
# --- Stage 14 : AI enhancement budgets (IMPLEMENTED — AI_PROVIDER_SPEC §2) ---
# Per-call provider timeout (seconds); adapters clamp every timeout_s into
# [1, AI_MAX_TIMEOUT_S]. DEFAULT > MAX fails boot (operator misconfig).
AI_DEFAULT_TIMEOUT_S=25
AI_MAX_TIMEOUT_S=60

# --- Stage 22+ : distributed limits + CAPTCHA (reserved) ---
# (Single-process RATE_LIMIT_* live in the Stage 04 block above; Stage 22 adds the shared
# store + per-account buckets. turnstile_token is accepted-and-ignored until then.)
# TURNSTILE_SECRET_KEY=changeme-turnstile-secret
# TURNSTILE_SITE_KEY=changeme-turnstile-site-key

# --- Stage 24+ : monitoring (reserved; enabling Sentry requires the scrubber — SECURITY_SPEC §10) ---
# SENTRY_DSN=
